# Скопируй этот файл: cp .env.example .env
# Заполни пустые строки ключами от заказчика.

GREEN_API_ID=
GREEN_API_TOKEN=
OPENAI_API_KEY=
MOYKLASS_API_KEY=
# Секрет в URL вебхуков MoyKlass (один для клиентов и сотрудников):
#   POST /moyklass-webhook/{MOYKLASS_WEBHOOK_SECRET}
#   POST /moyklass-webhook-employee/{MOYKLASS_WEBHOOK_SECRET}
MOYKLASS_WEBHOOK_SECRET=

# 0 = не слать WhatsApp клиентам из CRM (по умолчанию). 1 = включить снова.
MOYKLASS_CLIENT_WEBHOOKS_ENABLED=0

# Тест через CRM: все вебхуки (клиент + сотрудник) только на этот номер, с префиксом [ТЕСТ CRM].
# Пример: MOYKLASS_WEBHOOK_TEST_PHONE=+77001234567  Пусто = обычный режим.
MOYKLASS_WEBHOOK_TEST_PHONE=
