# Скопируй этот файл: cp .env.example .env
# Заполни пустые строки ключами от заказчика.

GREEN_API_ID=
GREEN_API_TOKEN=
OPENAI_API_KEY=
# Экономичная модель для RU/KZ; существующий .env переопределяет значение по умолчанию.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_COMPLETION_TOKENS=600
MOYKLASS_API_KEY=
# Секрет в URL вебхуков MoyKlass (один для клиентов и сотрудников):
#   POST /moyklass-webhook/{MOYKLASS_WEBHOOK_SECRET}
#   POST /moyklass-webhook-employee/{MOYKLASS_WEBHOOK_SECRET}
MOYKLASS_WEBHOOK_SECRET=

# 0 = не слать WhatsApp клиентам из CRM (по умолчанию). 1 = включить снова.
MOYKLASS_CLIENT_WEBHOOKS_ENABLED=0

# Тест через CRM: все вебхуки (клиент + сотрудник) только на этот номер, с префиксом [ТЕСТ CRM].
# Пример: MOYKLASS_WEBHOOK_TEST_PHONE=+77001234567  Пусто = обычный режим.
MOYKLASS_WEBHOOK_TEST_PHONE=

# Unix-время (сек): нижняя планка для CRM-вебхуков. При каждом старте бот
# автоматически поднимает её до времени старта (анти-бэклог при рестарте).
# Можно задать вручную: date +%s
MOYKLASS_WEBHOOK_ENABLED_SINCE=

# --- Антибан WhatsApp (защита номера от бана) ---
# 1 = включено. Интервал между любыми исходящими, кулдаун на чат, лимиты час/день.
WA_RATE_LIMIT_ENABLED=1
# 1 = режим прогрева нового номера (ещё жёстче лимиты). После 3–7 спокойных дней → 0.
WA_WARMUP_MODE=1
WA_MIN_INTERVAL_SEC=6
WA_PER_CHAT_COOLDOWN_SEC=20
WA_MAX_PER_HOUR=25
WA_MAX_PER_DAY=80
# Пауза исходящих при flood/quota от Green API (сек).
WA_FLOOD_PAUSE_SEC=300
# Не отвечать на входящие, накопленные пока бот был выключен / старше N сек.
WA_SKIP_OLD_INCOMING=1
WA_INCOMING_MAX_AGE_SEC=600

# Follow-up «спящим» лидам: на прогреве держать 0, потом можно 1.
FOLLOWUP_ENABLED=0

# Опционально: ID статуса «Клиент» в MoyKlass. Пусто = авто из GET /clientStatuses.
# Фильтр рассылок: lesson_start/class_start только ученикам со статусом «Клиент».
MOYKLASS_CLIENT_STATE_ID=

# --- Монитор посещаемости (2-й визит → проверка долга / 10 мин без отметки → не пришёл) ---
# Включать только вместе с MOYKLASS_WEBHOOK_TEST_PHONE на обкатке.
ATTENDANCE_MONITOR_ENABLED=0
ATTENDANCE_DRY_RUN=0
ATTENDANCE_SEED_ONLY=0
ATTENDANCE_UNMARKED_AFTER_MIN=10
MONTHLY_DEBT_VISIT_N=2
ATTENDANCE_CHECK_INTERVAL=60
ATTENDANCE_DEBT_LOOKBACK_MIN=120
ATTENDANCE_MAX_SEND_PER_TICK=5
# Қосымша / бесплатные абонементы — не слать «в долг»
DEBT_EXCLUDE_SUBSCRIPTION_IDS=132913,181106
DEBT_EXCLUDE_MAX_PRICE=1

# История диалогов и запреты сообщений (не удалять при деплое).
CONVERSATION_STATE_FILE=conversation_state.sqlite3
# Ожидание серии сообщений клиента перед ответом, секунды.
BUFFER_DELAY=8
# Дополнительные рабочие номера без продаж/follow-up (через запятую).
INTERNAL_PHONES=

# Постоянный учёт API usage и действий, не удалять при обновлении.
USAGE_STATE_FILE=usage_state.sqlite3
# Ежедневно в 09:00 Asia/Almaty за предыдущий календарный день.
DAILY_REPORT_ENABLED=1
DAILY_REPORT_PHONE=+77779559999
DAILY_REPORT_HOUR=9
# Неизвестная модель = неизвестная стоимость, а не $0.
# Переопределение USD/1 млн токенов: [input, cached input, output].
# OPENAI_PRICES_JSON={"my-model":[0.4,0.1,1.6]}
